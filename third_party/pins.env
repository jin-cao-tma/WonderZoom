# Upstream pins for WonderZoom: every external repository, commit and model revision.
#
# This file is the single source of truth for scripts/*.sh (which `source` it) and for
# scripts/*.py (which parse it). Format: one KEY=value per line, no spaces around '=',
# no quotes, no variable expansion. Lines starting with '#' are comments.
#
# Changing a pin means re-validating the pipeline (see docs/INSTALL.md). The setup and
# download scripts refuse anything other than these exact commits and revisions.

# ---------------------------------------------------------------------------------------
# Git repositories cloned into external/ by scripts/setup_third_party.sh
# ---------------------------------------------------------------------------------------
# Gen3C (Cosmos-Predict1 based camera-controlled video model), worker env wz-gen3c. No patch.
GEN3C_URL=https://github.com/nv-tlabs/GEN3C.git
GEN3C_COMMIT=2b50e0b497f76ace046636398dfab23edf4c43de
# NVIDIA apex, built (--cpp_ext --cuda_ext) inside wz-gen3c only. Gen3C imports amp_C at import time.
APEX_URL=https://github.com/NVIDIA/apex.git
APEX_COMMIT=e74a67bba3ee679f778670e17edc21639008ae0a
# Chain-of-Zoom (OSEDiff-SD3 super-resolution), worker env wz-coz. The SR LoRA/VAE checkpoints
# (ckpt/SR_LoRA, ckpt/SR_VAE) are git blobs and arrive with the clone. Upstream main breaks
# (utils.vaehook clashes with WonderZoom's utils/), so keep this pin.
COZ_URL=https://github.com/bryanswkim/Chain-of-Zoom.git
COZ_COMMIT=42deeda06449cbce6f52af2b400b1037f03a4cb0
# Step1X-Edit (object insertion), worker env wz-step1x. Upstream main requires
# Step1XParams.version, which simple_step1x.py does not pass, so keep this pin.
STEP1X_URL=https://github.com/stepfun-ai/Step1X-Edit.git
STEP1X_COMMIT=4174b2855f7d206a580a4710b945211dc7bf8be7
# INR-Harmonization (optional harmonization), patched with third_party/inr_harmonization/*.patch.
INR_URL=https://github.com/WindVChen/INR-Harmonization.git
INR_COMMIT=19946ddaffad415ee72fdda7741db8a2b4379606
# Grounded-Segment-Anything (optional objects): its GroundingDINO/ and segment_anything/
# subdirectories are pip-installed into wz-main by scripts/install_objects_optional.sh.
GSAM_URL=https://github.com/IDEA-Research/Grounded-Segment-Anything.git
GSAM_COMMIT=126abe633ffe333e16e4a0a4e946bc1003caf757

# ---------------------------------------------------------------------------------------
# Sources built into the main env (wz-main) by scripts/install_env_main.sh
# ---------------------------------------------------------------------------------------
# GLM headers for submodules/depth-diff-gaussian-rasterization-min/third_party/glm. This is the
# commit the graphdeco-inria rasterizer pins (0.9.9.8-258); the release build was validated with it.
GLM_URL=https://github.com/g-truc/glm.git
GLM_COMMIT=5c46b9c07008ae65cb81ab79cd677ecc1934b903
# PyTorch3D v0.7.8, built from source with --no-build-isolation.
PYTORCH3D_URL=https://github.com/facebookresearch/pytorch3d.git
PYTORCH3D_COMMIT=75ebeeaea0908c5527e7b1e305fbc7681382db47
# utils3d (old API needed by MoGe v1 and models/vdm_model.py). PyPI 'utils3d' is an unrelated
# project. Installed through requirements/main.txt; keep the commit there in sync with this one.
UTILS3D_URL=https://github.com/EasternJournalist/utils3d.git
UTILS3D_COMMIT=3913c65d81e05e47b9f367250cf8c0f7462a0900

# ---------------------------------------------------------------------------------------
# Prebuilt wheels
# ---------------------------------------------------------------------------------------
# flash-attn for wz-step1x (torch 2.7.1, CUDA 12, cxx11 ABI, CPython 3.10). Validated on this release.
FLASH_ATTN_WHEEL_URL=https://github.com/Dao-AILab/flash-attention/releases/download/v2.7.4.post1/flash_attn-2.7.4.post1+cu12torch2.7cxx11abiTRUE-cp310-cp310-linux_x86_64.whl

# ---------------------------------------------------------------------------------------
# Hugging Face repositories and pinned revisions (commit hashes).
# Used by scripts/download_checkpoints.sh (via scripts/prefetch_hf.py) and by the loaders.
# ---------------------------------------------------------------------------------------
